+# LLM agent source (x2-groot-vla gemma_ctl, 2026-10-23): LOWEST priority and
+# remote over wifi. Any pad/VR message preempts it and locks it out for
+# _LLM_LOCKOUT_S after the last human message; while it owns, silence longer
+# than _LLM_SILENCE_S (agent heartbeats every 0.3 s) = link loss -> idle +
+# primitive exit, so a dropped wifi link can never leave a latched walk.
+_LLM_SILENCE_S = 1.0
+_LLM_LOCKOUT_S = 3.0
+_cmd_owner = {"src": None, "vr_ts": 0.0, "llm_ts": 0.0, "human_ts": 0.0}
+
+
+def _llm_silence_check() -> bool:
+    """True (and owner released) when the LLM owner went silent."""
+    if (_cmd_owner["src"] == "llm"
+            and time.monotonic() - _cmd_owner["llm_ts"] > _LLM_SILENCE_S):
+        log.warning("cmd owner: LLM silent %.1fs > %.1fs — link lost, idling",
+                    time.monotonic() - _cmd_owner["llm_ts"], _LLM_SILENCE_S)
+        _cmd_owner["src"] = None
+        return True
+    return False
 
